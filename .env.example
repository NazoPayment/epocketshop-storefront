# API used to load stores, look up customers and update customer details.
# Defaults to production; in `npm run dev` it defaults to a Vite proxy to production
# (reads only; customer updates are ignored in dev).
VITE_API_BASE_URL=https://api.prod.whatsapp-service.epocketshop.store

# API that receives submitted orders.
# Defaults to production; in `npm run dev` it defaults to http://localhost:5010.
VITE_ORDER_API_URL=https://api.prod.epocketshop-service.epocketshop.store

# Public base URL used in the order message ("Store Url -> ...").
VITE_STORE_BASE_URL=https://epocketshop.store

# Fallback WhatsApp number (E.164) used when a store has no vendor number.
VITE_DEFAULT_WHATSAPP_NUMBER=+27739379358

# Links shown to people who want to sell on ePocketShop (home page).
# Admin dashboard: where they sign in or register and create their store.
VITE_ADMIN_URL=https://epocketshopadmin-1hadyzjgy-ptmahlangu.vercel.app/login
# Marketing site: more information about ePocketShop.
VITE_INFO_URL=https://epocketshop-web.vercel.app/
