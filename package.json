{
  "name": "epocketshop-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ePocketShop storefront rebuilt with React and the Astryx design system",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.7.14",
    "@astryxdesign/core": "^0.7.14",
    "@astryxdesign/theme-butter": "0.7.14",
    "@stylexjs/stylex": "^0.19.2",
    "lucide-react": "^1.72.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
